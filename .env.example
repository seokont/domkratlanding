# Copy to .env.local and fill in. All variables are read at BUILD time
# (static export) — rebuild after changing them.

# Public site URL (canonical, hreflang, Open Graph, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Product name shown in the header, footer, titles and OG image.
NEXT_PUBLIC_BRAND_NAME=Domkrat STO

# "Log in" button target (the app itself).
NEXT_PUBLIC_APP_URL=https://app.example.com

# Where the lead form POSTs JSON. Defaults to /api/leads
# (stubbed only in `npm run dev`, see src/app/api/leads/route.dev.ts).
NEXT_PUBLIC_LEADS_ENDPOINT=

# Telegram link for the "Message us on Telegram" button and footer.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/example

# Analytics — leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
